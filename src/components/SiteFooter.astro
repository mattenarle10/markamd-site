---
type Props = {
  version: string;
};
const { version } = Astro.props;
const repoUrl = "https://github.com/mattenarle10/markamd";
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__brand">
      <img src="/mascot/logo.png" alt="" width="20" height="20" />
      <span>marka.md · {version}</span>
    </div>
    <nav class="foot__links">
      <a href="/">home</a>
      <a href="/docs">docs</a>
      <a href={repoUrl} target="_blank" rel="noopener">github</a>
      <a href="/changelog">changelog</a>
      <a href="/feedback">feedback</a>
      <a href="/privacy">privacy</a>
      <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
    </nav>
  </div>
</footer>

<style is:global>
  .foot {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .foot__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .foot__inner {
      flex-direction: row;
    }
  }
  .foot__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .foot__links {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .foot__links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .foot__links a:hover {
    color: var(--fg);
  }
</style>
