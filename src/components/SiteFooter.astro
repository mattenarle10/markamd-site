---
type Props = {
  version: string;
};
const { version } = Astro.props;
const repoUrl = "https://github.com/mattenarle10/markamd";
---

<footer class="foot">
  <div class="foot__featured">
    <a
      href="https://www.producthunt.com/products/marka-md?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-marka-md"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="marka.md featured on Product Hunt"
    >
      <img
        src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1148089&theme=light&t=1778916303617"
        alt="marka.md - the markdown editor for AI context. | Product Hunt"
        width="250"
        height="54"
        loading="lazy"
      />
    </a>
  </div>
  <div class="foot__inner">
    <div class="foot__brand">
      <img src="/mascot/logo.png" alt="" width="20" height="20" />
      <span>marka.md · {version}</span>
    </div>
    <nav class="foot__links">
      <a href="/">home</a>
      <a href={repoUrl} target="_blank" rel="noopener">github</a>
      <a href="/changelog">changelog</a>
      <a href="/feedback">feedback</a>
      <a href="/privacy">privacy</a>
      <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
    </nav>
  </div>
</footer>

<style is:global>
  .foot {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }
  .foot__featured {
    display: flex;
    justify-content: center;
    padding: 24px 24px 0;
  }
  .foot__featured a {
    display: inline-block;
    line-height: 0;
    transition: opacity 180ms ease;
  }
  .foot__featured a:hover { opacity: 0.85; }
  .foot__featured img {
    width: 250px;
    height: 54px;
  }
  .foot__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .foot__inner {
      flex-direction: row;
    }
  }
  .foot__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .foot__links {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .foot__links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .foot__links a:hover {
    color: var(--fg);
  }
</style>
