---
// stylized mock that mirrors the real marka.md window — inline lucide-style
// SVG icons match the app's chrome (theme, reading toggle, copy, new, open,
// folder, sidebar toggle, search, file, folder, chevrons, help). updates
// here should track marka.md's actual UI when it evolves.
---

<div class="mock">
  <div class="mock__win">
    <!-- title bar -->
    <div class="mock__titlebar">
      <div class="mock__lights">
        <span class="mock__light mock__light--red"></span>
        <span class="mock__light mock__light--yellow"></span>
        <span class="mock__light mock__light--green"></span>
      </div>
      <div class="mock__filename">claude-prompt.md</div>
      <div class="mock__actions">
        <!-- reading mode toggle (book) -->
        <button class="mock__icbtn" aria-label="reading mode">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
        </button>
        <!-- theme (sun) -->
        <button class="mock__icbtn" aria-label="theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- breadcrumb -->
    <div class="mock__breadcrumb">
      <button class="mock__icbtn mock__icbtn--sm" aria-label="sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M9 3v18"/>
          <path d="m16 15-3-3 3-3"/>
        </svg>
      </button>
      <span class="mock__bc-path">
        <span class="mock__seg">notes</span>
        <svg class="mock__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="mock__seg">claude</span>
        <svg class="mock__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="mock__seg mock__seg--leaf">claude-prompt.md</span>
      </span>
      <span class="mock__save">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        saved
      </span>
      <span class="mock__bc-actions">
        <button class="mock__icbtn mock__icbtn--copy" aria-label="copy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
        </button>
        <button class="mock__icbtn mock__icbtn--sm" aria-label="new">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
            <path d="M14 2v4a2 2 0 0 0 2 2h4M9 15h6M12 12v6"/>
          </svg>
        </button>
        <button class="mock__icbtn mock__icbtn--sm" aria-label="open file">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/>
            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
          </svg>
        </button>
        <button class="mock__icbtn mock__icbtn--sm" aria-label="open folder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/>
          </svg>
        </button>
      </span>
    </div>

    <!-- main panes -->
    <div class="mock__shell">
      <!-- sidebar -->
      <aside class="mock__sidebar">
        <div class="mock__sb-head">
          <span class="mock__sb-title">claude</span>
          <span class="mock__sb-icons">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/></svg>
          </span>
        </div>
        <ul class="mock__tree">
          <li class="mock__row mock__row--folder">
            <svg class="mock__row-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
            <span>inbox</span>
          </li>
          <li class="mock__row mock__row--folder">
            <svg class="mock__row-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
            <span>projects</span>
          </li>
          <li class="mock__row">
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            <span>architecture.md</span>
          </li>
          <li class="mock__row mock__row--active">
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            <span>claude-prompt.md</span>
          </li>
          <li class="mock__row">
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            <span>system-msg.md</span>
          </li>
          <li class="mock__row">
            <svg class="mock__row-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5Z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            <span>today.md</span>
          </li>
        </ul>
      </aside>

      <!-- editor -->
      <div class="mock__editor">
        <div class="mock__lines">
          <div class="mock__line"><span class="mock__gutter">1</span><span class="mock__h">## claude prompt</span></div>
          <div class="mock__line"><span class="mock__gutter">2</span></div>
          <div class="mock__line"><span class="mock__gutter">3</span><span>you are a senior reviewer for</span></div>
          <div class="mock__line"><span class="mock__gutter">4</span><span>this <span class="mock__em">*markdown*</span> editor.</span></div>
          <div class="mock__line"><span class="mock__gutter">5</span></div>
          <div class="mock__line"><span class="mock__gutter">6</span><span>- be terse</span></div>
          <div class="mock__line"><span class="mock__gutter">7</span><span>- cite line numbers</span></div>
          <div class="mock__line">
            <span class="mock__gutter">8</span>
            <span>- flag missing checks<span class="mock__cursor"></span></span>
          </div>
        </div>
      </div>

      <!-- preview -->
      <div class="mock__preview">
        <h2 class="mock__pv-h2">claude prompt</h2>
        <div class="mock__pv-rule"></div>
        <p class="mock__pv-p">you are a senior reviewer for this <em>markdown</em> editor.</p>
        <ul class="mock__pv-list">
          <li>be terse</li>
          <li>cite line numbers</li>
          <li class="mock__pv-fade">flag missing checks</li>
        </ul>
      </div>
    </div>

    <!-- status bar -->
    <div class="mock__statusbar">
      <span>claude-prompt.md</span>
      <span class="mock__sb-stats">
        42 words · ~58 tokens · 1 min read
        <svg class="mock__help" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg>
      </span>
    </div>
  </div>

  <!-- floating "copied" toast — top-right of the window -->
  <div class="mock__toast">
    <span class="mock__toast-art">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
    <span>copied to clipboard · paste into claude</span>
  </div>
</div>

<style>
  .mock { position: relative; width: 100%; perspective: 1400px; }
  .mock__win {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #fafaf9;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 14px;
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.22),
      0 6px 18px -6px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    display: grid;
    grid-template-rows: 38px 30px 1fr 26px;
    font-family: "SF Mono", "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    color: #4c4f69;
    transform: rotateX(2deg);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reveal.is-visible .mock__win { transform: rotateX(0deg); }

  /* ---- shared icon button ---- */
  .mock__icbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: #8c8fa1;
    cursor: default;
    transition: background 200ms ease, color 200ms ease;
  }
  .mock__icbtn:hover { background: rgba(0, 0, 0, 0.05); color: #4c4f69; }
  .mock__icbtn svg { width: 13px; height: 13px; }
  .mock__icbtn--sm { width: 20px; height: 20px; }
  .mock__icbtn--sm svg { width: 12px; height: 12px; }
  .mock__icbtn--copy { color: #e2722e; background: #fff3eb; }

  /* ---- titlebar ---- */
  .mock__titlebar {
    display: grid;
    grid-template-columns: 90px 1fr 90px;
    align-items: center;
    padding: 0 12px;
    background: #fff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .mock__lights { display: inline-flex; gap: 6px; }
  .mock__light { width: 11px; height: 11px; border-radius: 999px; }
  .mock__light--red    { background: #ff5f57; }
  .mock__light--yellow { background: #febc2e; }
  .mock__light--green  { background: #28c840; }
  .mock__filename {
    text-align: center;
    color: #4c4f69;
    font-size: 11px;
    letter-spacing: 0.005em;
  }
  .mock__actions { display: inline-flex; gap: 2px; justify-content: flex-end; }

  /* ---- breadcrumb ---- */
  .mock__breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px 0 8px;
    background: #fff;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 10.5px;
    color: #8c8fa1;
  }
  .mock__bc-path {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    margin-left: 4px;
  }
  .mock__seg {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mock__seg--leaf { color: #4c4f69; }
  .mock__chev { width: 9px; height: 9px; color: #ccd0da; flex-shrink: 0; }
  .mock__save {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px 1px 6px;
    background: #fff3eb;
    color: #e2722e;
    border-radius: 999px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .mock__save svg { width: 9px; height: 9px; }
  .mock__bc-actions {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    padding-left: 8px;
    margin-left: 4px;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
  }

  /* ---- shell ---- */
  .mock__shell {
    display: grid;
    grid-template-columns: minmax(0, 22%) minmax(0, 38%) minmax(0, 40%);
    min-height: 0;
    overflow: hidden;
  }

  /* ---- sidebar ---- */
  .mock__sidebar {
    background: #fff;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }
  .mock__sb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 10px 9px 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 10px;
    color: #1d1d1f;
  }
  .mock__sb-title {
    font-family: "SF Mono", ui-monospace, monospace;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }
  .mock__sb-icons { display: inline-flex; gap: 4px; color: #8c8fa1; }
  .mock__sb-icons svg { width: 11px; height: 11px; }
  .mock__tree { list-style: none; margin: 0; padding: 6px 0; }
  .mock__row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px 5px 12px;
    font-size: 10.5px;
    color: #4c4f69;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    position: relative;
  }
  .mock__row--folder { padding-left: 6px; }
  .mock__row--active {
    background: rgba(226, 114, 46, 0.12);
    color: #e2722e;
    box-shadow: inset 2px 0 0 #e2722e;
  }
  .mock__row-chev { width: 10px; height: 10px; color: #9ca0b0; flex-shrink: 0; }
  .mock__row-ic { width: 12px; height: 12px; color: #9ca0b0; flex-shrink: 0; }
  .mock__row--active .mock__row-ic { color: #e2722e; }

  /* ---- editor ---- */
  .mock__editor {
    background: #fafaf9;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    overflow: hidden;
    padding: 14px 0;
  }
  .mock__lines { font-size: 11px; line-height: 1.75; color: #4c4f69; }
  .mock__line { display: flex; gap: 12px; padding: 0 14px; }
  .mock__gutter { color: #bcc0cc; width: 14px; text-align: right; flex-shrink: 0; }
  .mock__h { color: #1d1d1f; font-weight: 600; }
  .mock__em { color: #e2722e; }
  .mock__cursor {
    display: inline-block;
    width: 2px;
    height: 12px;
    margin-left: 1px;
    margin-bottom: -2px;
    background: #e2722e;
    animation: mock-blink 1s steps(2, end) infinite;
  }
  @keyframes mock-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* ---- preview ---- */
  .mock__preview {
    background: #fff;
    overflow: hidden;
    padding: 18px 22px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    color: #1d1d1f;
  }
  .mock__pv-h2 {
    font-family: -apple-system, "SF Pro Display", system-ui, sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    color: #1d1d1f;
  }
  .mock__pv-rule {
    height: 1px;
    width: 28%;
    background: #e2722e;
    margin-bottom: 14px;
    border-radius: 1px;
  }
  .mock__pv-p {
    font-size: 12px;
    line-height: 1.7;
    color: #4c4f69;
    margin: 0 0 10px;
  }
  .mock__pv-p em {
    font-style: italic;
    color: #e2722e;
  }
  .mock__pv-list {
    margin: 0;
    padding-left: 18px;
    font-size: 12px;
    line-height: 1.8;
    color: #4c4f69;
  }
  .mock__pv-list li::marker { color: #e2722e; }
  .mock__pv-fade {
    opacity: 0;
    animation: mock-fade-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 1.4s forwards;
  }
  @keyframes mock-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ---- statusbar ---- */
  .mock__statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 10px;
    color: #8c8fa1;
  }
  .mock__sb-stats { display: inline-flex; align-items: center; gap: 8px; }
  .mock__help { width: 11px; height: 11px; }

  /* ---- toast ---- */
  .mock__toast {
    position: absolute;
    top: 56px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: #fff;
    border: 1px solid rgba(226, 114, 46, 0.35);
    border-radius: 10px;
    font-family: -apple-system, "SF Pro Text", system-ui, sans-serif;
    font-size: 11px;
    color: #1d1d1f;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateX(20px);
    animation:
      mock-toast-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 1.8s forwards,
      mock-toast-out 600ms cubic-bezier(0.2, 0.7, 0.2, 1) 4.8s forwards;
  }
  @keyframes mock-toast-in {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes mock-toast-out {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(8px); }
  }
  .mock__toast-art {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    background: #fff3eb;
    color: #e2722e;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .mock__toast-art svg { width: 11px; height: 11px; }
</style>
