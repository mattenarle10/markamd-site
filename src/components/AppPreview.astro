---
// gallery of marka.md screenshots — click a tab to swap the main image.
// to add more shots: drop a PNG into /public/preview/ and add an entry below.
const screenshots: { src: string; label: string; alt: string }[] = [
  {
    src: "/preview/hero.png",
    label: "editor",
    alt: "split editor + live preview of a README, with a sidebar of markdown files",
  },
  {
    src: "/preview/preview.png",
    label: "preview",
    alt: "rendered markdown with code blocks, headings, and inline formatting",
  },
  {
    src: "/preview/themes.png",
    label: "themes",
    alt: "theme switcher showing catppuccin and matcha color palettes",
  },
  {
    src: "/preview/diagrams.png",
    label: "diagrams",
    alt: "mermaid diagram rendered inline with surrounding markdown",
  },
];
---

<div class="preview-wrap">
  <div
    class="preview"
    role="img"
    aria-label={`screenshot of marka.md — ${screenshots[0].alt}`}
  >
    <img
      id="preview-img"
      src={screenshots[0].src}
      alt=""
      width="2048"
      height="1280"
      decoding="async"
      loading="lazy"
      data-fallback="/preview/hero.png"
    />
  </div>

  <div class="preview__tabs" role="tablist" aria-label="screenshot views">
    {
      screenshots.map((s, i) => (
        <button
          type="button"
          class={`preview__tab${i === 0 ? " preview__tab--active" : ""}`}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          data-src={s.src}
          data-alt={s.alt}
        >
          {s.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  const img = document.getElementById("preview-img") as HTMLImageElement | null;
  const wrap = document.querySelector(".preview") as HTMLElement | null;
  const tabs = document.querySelectorAll<HTMLButtonElement>(".preview__tab");
  if (img && wrap && tabs.length) {
    const fallback = img.dataset.fallback || "/preview/hero.png";
    img.addEventListener("error", () => {
      if (!img.src.endsWith(fallback)) img.src = fallback;
    });
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const src = tab.dataset.src;
        const alt = tab.dataset.alt || "";
        if (!src) return;
        img.src = src;
        wrap.setAttribute("aria-label", `screenshot of marka.md — ${alt}`);
        tabs.forEach((t) => {
          t.classList.toggle("preview__tab--active", t === tab);
          t.setAttribute("aria-selected", t === tab ? "true" : "false");
        });
      });
    });
  }
</script>

<style is:global>
  .preview-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .preview {
    position: relative;
    width: 100%;
    perspective: 1400px;
  }
  .preview img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.22),
      0 6px 18px -6px rgba(0, 0, 0, 0.08);
    transform: rotateX(2deg);
    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 220ms ease;
  }
  .reveal.is-visible .preview img {
    transform: rotateX(0deg);
  }
  .preview__tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding: 4px;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid var(--border);
    border-radius: 999px;
    width: fit-content;
    margin: 0 auto;
    font-family: var(--font-mono);
  }
  .preview__tab {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 6px 14px;
    font: inherit;
    font-size: 12.5px;
    color: var(--muted);
    cursor: pointer;
    border-radius: 999px;
    transition:
      color 180ms ease,
      background 180ms ease;
  }
  .preview__tab:hover {
    color: var(--fg);
  }
  .preview__tab--active {
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
</style>
