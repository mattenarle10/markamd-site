---
// rotating carousel of real marka.md screenshots — crossfades through 4
// slides every ~4s. preserves the 3D tilt-on-reveal from the previous
// single-image version. dot indicators below let users jump.

const slides = [
  { src: "/preview/01-editor.png", label: "split editor with live preview" },
  { src: "/preview/02-palette.png", label: "⌘K command palette in dark theme" },
  { src: "/preview/03-reading.png", label: "reading mode with copy toast" },
  { src: "/preview/04-matcha.png", label: "matcha theme welcome screen" },
];
---

<div class="preview" data-carousel>
  <div
    class="preview__viewport"
    role="img"
    aria-label="screenshots of marka.md cycling through editor, palette, reading mode, and matcha theme"
  >
    {slides.map((slide, i) => (
      <img
        class="preview__slide"
        data-slide={i}
        data-active={i === 0 ? "true" : "false"}
        src={slide.src}
        alt={slide.label}
        width="2048"
        height="1280"
        decoding="async"
        loading={i === 0 ? "eager" : "lazy"}
      />
    ))}
  </div>
  <div class="preview__dots" role="tablist" aria-label="preview slide selector">
    {slides.map((slide, i) => (
      <button
        type="button"
        class="preview__dot"
        data-dot={i}
        data-active={i === 0 ? "true" : "false"}
        role="tab"
        aria-label={`show ${slide.label}`}
        aria-selected={i === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>
</div>

<style is:global>
  .preview {
    position: relative;
    width: 100%;
    perspective: 1400px;
  }
  .preview__viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 2048 / 1280;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.22),
      0 6px 18px -6px rgba(0, 0, 0, 0.08);
    transform: rotateX(2deg);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    background: #1a1a1a;
  }
  .reveal.is-visible .preview__viewport {
    transform: rotateX(0deg);
  }
  .preview__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
    display: block;
  }
  .preview__slide[data-active="true"] {
    opacity: 1;
  }
  .preview__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }
  .preview__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 0;
    background: var(--border);
    cursor: pointer;
    padding: 0;
    transition: background 220ms ease, transform 220ms ease, width 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .preview__dot:hover {
    background: color-mix(in srgb, var(--accent) 55%, var(--border));
  }
  .preview__dot[data-active="true"] {
    background: var(--accent);
    width: 22px;
  }
  @media (max-width: 640px) {
    .preview__dot { width: 7px; height: 7px; }
    .preview__dot[data-active="true"] { width: 18px; }
    .preview__dots { margin-top: 14px; gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .preview__slide { transition: none; }
    .preview__dot { transition: none; }
  }
</style>

<script>
  function setup() {
    const root = document.querySelector<HTMLElement>("[data-carousel]");
    if (!root) return;

    const slides = Array.from(root.querySelectorAll<HTMLElement>(".preview__slide"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".preview__dot"));
    if (slides.length === 0) return;

    let current = 0;
    let timer: number | null = null;
    const intervalMs = 4200;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (next: number) => {
      const n = ((next % slides.length) + slides.length) % slides.length;
      slides.forEach((s, i) => s.dataset.active = String(i === n));
      dots.forEach((d, i) => {
        d.dataset.active = String(i === n);
        d.setAttribute("aria-selected", String(i === n));
      });
      current = n;
    };

    const start = () => {
      if (reduced) return;
      stop();
      timer = window.setInterval(() => show(current + 1), intervalMs);
    };
    const stop = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        start();
      });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);

    start();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup, { once: true });
  } else {
    setup();
  }
</script>
