---
// real screenshot of the marka.md window — replaces the previous static HTML
// mock. swap in /preview/hero.png to refresh; image is treated as a single
// labelled visual for screen readers.
---

<div
  class="preview"
  role="img"
  aria-label="screenshot of marka.md showing a split editor + live preview of a README, with a sidebar of markdown files"
>
  <img
    src="/preview/hero.png"
    alt=""
    width="2048"
    height="1280"
    decoding="async"
    loading="lazy"
  />
</div>

<style is:global>
  .preview {
    position: relative;
    width: 100%;
    perspective: 1400px;
  }
  .preview img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.22),
      0 6px 18px -6px rgba(0, 0, 0, 0.08);
    transform: rotateX(2deg);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reveal.is-visible .preview img {
    transform: rotateX(0deg);
  }
</style>
