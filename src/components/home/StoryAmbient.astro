---
// A single decorative layer for the horizontal story. Keep this as the first
// child of `.story` so every chapter shares the same visual surface.
---

<div class="story-ambient" data-story-ambient aria-hidden="true">
  <div class="story-ambient__wash"></div>
  <div class="story-ambient__orb story-ambient__orb--one"></div>
  <div class="story-ambient__orb story-ambient__orb--two"></div>
  <div class="story-ambient__orb story-ambient__orb--three"></div>
  <div class="story-ambient__grain"></div>
</div>
