---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "marka.md — your local markdown for AI context",
  description = "a calm, local markdown editor built for the notes you share with claude. collect, write, share. macOS, Windows, Linux, open source, MIT.",
} = Astro.props;

// Google Search Console verification — set GSC_VERIFICATION in Vercel env to
// the code from the "HTML tag" verification method (just the content value).
// If unset, the meta tag is omitted.
const gscVerification = import.meta.env.GSC_VERIFICATION as string | undefined;
const siteUrl = "https://markamd.vercel.app";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "marka.md",
  alternateName: ["markamd", "marka md", "marka-md"],
  description:
    "a calm, local markdown editor built for the notes you share with claude and other ai assistants. local-first, no telemetry, MIT licensed.",
  url: siteUrl,
  downloadUrl: "https://github.com/mattenarle10/markamd/releases/latest",
  image: `${siteUrl}/mascot/logo.png`,
  applicationCategory: "ProductivityApplication",
  applicationSubCategory: "Markdown Editor",
  operatingSystem: "macOS, Windows, Linux",
  softwareVersion: "1.4.1",
  license: "https://opensource.org/licenses/MIT",
  author: {
    "@type": "Person",
    name: "Matt Enarle",
    url: "https://github.com/mattenarle10",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  sameAs: [
    "https://github.com/mattenarle10/markamd",
    "https://www.producthunt.com/products/marka-md",
    "https://alternativeto.net/software/marka-md/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="markamd, marka.md, marka md, markdown editor, ai context editor, claude context, claude.md editor, local markdown, tauri markdown app, macos markdown editor, windows markdown editor, linux markdown editor, open source markdown" />
    <meta name="author" content="Matt Enarle" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="marka.md (markamd)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/mascot/logo.png`} />
    <meta property="og:image:alt" content="marka.md — orange octopus mascot logo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/mascot/logo.png`} />
    {gscVerification ? (
      <meta name="google-site-verification" content={gscVerification} />
    ) : null}
    <link rel="icon" type="image/png" href="/mascot/logo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
  </head>
  <body class="bg-bg text-fg">
    <slot />
    <Analytics />
    <SpeedInsights />
    <script>
      import "../scripts/motion";
      import "../scripts/word-reveal";
      import "../scripts/hero-ambient";
    </script>
  </body>
</html>
