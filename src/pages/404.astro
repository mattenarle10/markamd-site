---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getLatestRelease } from "../lib/version";

const { tag: version } = await getLatestRelease();
---

<Layout
  title="404 · marka.md"
  description="this page swam away. let's get you back to dry land 🐙"
>
  <SiteNav />

  <main class="nf">
    <div class="nf__inner">
      <div class="nf__copy">
        <p class="nf__code">lost at sea · 404</p>
        <h1 class="nf__title">
          this page<br /><span class="nf__accent">swam away.</span>
        </h1>
        <p class="nf__lede">
          the octopus searched everywhere — no luck. maybe the link is old, or the
          page never existed. let’s get you back to dry land.
        </p>
        <div class="nf__ctas">
          <a class="nf__btn nf__btn--primary" href="/">← back home</a>
          <a class="nf__btn" href="/changelog">changelog</a>
          <a class="nf__btn" href="/feedback">report broken link</a>
        </div>
      </div>

      <div class="nf__scene">
        <div class="nf__ring nf__ring--one" aria-hidden="true"></div>
        <div class="nf__ring nf__ring--two" aria-hidden="true"></div>
        <div class="nf__mascot" aria-hidden="true">
        <img src="/mascot/inspect.png" alt="" width="200" height="200" />
        </div>
      </div>

      <div class="nf__hints">
        <p class="nf__hints-title">looking for something specific?</p>
        <ul class="nf__hints-list">
          <li><a href="/">home + downloads</a></li>
          <li><a href="/changelog">changelog (every release)</a></li>
          <li><a href="/privacy">privacy policy</a></li>
          <li><a href="/feedback">feedback &amp; bug reports</a></li>
          <li>
            <a
              href="https://github.com/mattenarle10/markamd"
              target="_blank"
              rel="noopener">github repo</a
            >
          </li>
        </ul>
      </div>
    </div>
  </main>

  <SiteFooter version={version} />
</Layout>

<style is:global>
  .nf {
    background: radial-gradient(circle at 77% 42%, var(--accent-soft), transparent 30%), var(--bg);
    padding: 32px 24px;
    min-height: calc(100svh - 56px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nf__inner {
    width: min(1120px, 100%);
    margin: 0 auto;
    color: var(--fg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .nf__copy { max-width: 520px; }
  .nf__scene { position: relative; min-height: 420px; display: grid; place-items: center; }
  .nf__ring { position: absolute; border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 50%; }
  .nf__ring--one { width: min(38vw, 440px); aspect-ratio: 1; }
  .nf__ring--two { width: min(27vw, 310px); aspect-ratio: 1; }
  .nf__mascot {
    margin: 0;
    width: 200px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: nf-float 4s ease-in-out infinite;
  }
  .nf__mascot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  @keyframes nf-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .nf__title {
    font-family: var(--font-display);
    font-size: clamp(52px, 6.2vw, 88px);
    line-height: .92;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .nf__accent { color: var(--accent); }
  .nf__lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 36px;
    max-width: 480px;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 10px;
    margin-bottom: 0;
  }
  .nf__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
    transition:
      border-color 220ms ease,
      background 220ms ease,
      transform 180ms ease;
  }
  .nf__btn:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    transform: translateY(-1px);
  }
  .nf__btn--primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .nf__btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 92%, black);
    border-color: color-mix(in srgb, var(--accent) 92%, black);
    color: #fff;
  }
  .nf__hints {
    border-top: 1px solid var(--border);
    padding-top: 32px;
    text-align: left;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 24px;
    align-items: start;
  }
  .nf__hints-title {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 14px;
    text-align: left;
  }
  .nf__hints-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .nf__hints-list li {
    font-size: 14px;
    line-height: 1.55;
  }
  .nf__hints-list a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .nf__hints-list a:hover {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__mascot {
      animation: none;
    }
  }
  @media (max-width: 720px) {
    .nf { padding: 48px 24px; }
    .nf__inner { display: flex; flex-direction: column; align-items: stretch; gap: 28px; }
    .nf__scene { min-height: 250px; order: -1; }
    .nf__mascot { width: 150px; height: 150px; }
    .nf__ring--one { width: 250px; }
    .nf__ring--two { width: 180px; }
    .nf__hints { display: block; }
  }
</style>
