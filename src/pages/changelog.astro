---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getReleases, getLatestRelease } from "../lib/version";
import { marked } from "marked";
import "../styles/pages/changelog.css";

const repoUrl = "https://github.com/mattenarle10/markamd";
const { tag: version } = await getLatestRelease();
const releases = await getReleases(20);

const formatDate = (iso: string): string => {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};

// release bodies are author-controlled (we write them via release.yml); safe to render as html.
const rendered = releases.map((r) => ({
  ...r,
  bodyHtml: r.body.trim() ? (marked.parse(r.body, { async: false }) as string) : "",
  prettyDate: formatDate(r.publishedAt),
}));
const [latestRelease, ...previousReleases] = rendered;
---

<Layout
  title="changelog · marka.md"
  description="every release of marka.md — auto-fresh from GitHub releases, including the latest preview-window and markdown insertion notes."
>
  <SiteNav />

  <main class="changelog">
    <header class="changelog__intro">
      <p class="changelog__eyebrow eyebrow">release notes</p>
      <h1>what's been<br /><em>moving.</em></h1>
      <p>every version of marka.md, straight from github.</p>
    </header>

    {rendered.length === 0 ? (
      <div class="changelog__empty">
        <p>couldn't load releases right now — see the full list on github:</p>
        <a href={`${repoUrl}/releases`} target="_blank" rel="noopener">
          github.com/mattenarle10/markamd/releases →
        </a>
      </div>
    ) : (
      <>
        {latestRelease && (
          <article class="release-feature" aria-labelledby="latest-release">
            <div class="release-feature__meta">
              <span class="release-feature__label">latest release</span>
              <p>{latestRelease.prettyDate || "just now"}</p>
              {latestRelease.isPrerelease && <span class="release-pill">preview</span>}
            </div>
            <div class="release-feature__content">
              <div class="release-feature__title-row">
                <h2 id="latest-release">{latestRelease.tag}</h2>
                <a href={latestRelease.htmlUrl} target="_blank" rel="noopener">view on github <span aria-hidden="true">↗</span></a>
              </div>
              {latestRelease.bodyHtml ? (
                <div class="release-body" set:html={latestRelease.bodyHtml} />
              ) : (
                <p class="release-body release-body--empty">no notes for this release.</p>
              )}
            </div>
          </article>
        )}

        {previousReleases.length > 0 && (
          <section class="release-archive" aria-labelledby="archive-title">
            <header class="release-archive__head">
              <p>the archive</p>
              <h2 id="archive-title">earlier versions</h2>
            </header>
            <ol class="release-list">
              {previousReleases.map((r) => (
                <li class="release-entry">
                  <div class="release-meta">
                    <span class="release-meta__node" aria-hidden="true"></span>
                    <h3>{r.tag}</h3>
                    <p>{r.prettyDate}</p>
                    {r.isPrerelease && <span class="release-pill">preview</span>}
                    <a href={r.htmlUrl} target="_blank" rel="noopener" aria-label={`View ${r.tag} on GitHub`}>↗</a>
                  </div>
                  {r.bodyHtml ? (
                    <div class="release-body" set:html={r.bodyHtml} />
                  ) : (
                    <p class="release-body release-body--empty">no notes for this release.</p>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}
      </>
    )}
  </main>

  <SiteFooter version={version} />
</Layout>
