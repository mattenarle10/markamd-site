---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getLatestRelease } from "../lib/version";

const repoUrl = "https://github.com/mattenarle10/markamd";
const { tag: version } = await getLatestRelease();

const feedbackUrl = `${repoUrl}/issues/new?template=feedback.yml`;
const bugUrl = `${repoUrl}/issues/new?template=bug-report.yml`;
const mailto = "mailto:enarlem10@gmail.com?subject=marka.md%20feedback";
---

<Layout
  title="feedback · marka.md"
  description="share thoughts, ideas, or report a bug. github for technical, email for everything else."
>
  <SiteNav />

  <main class="fb">
    <article class="fb__article">
      <header class="fb__intro">
        <p class="fb__eyebrow">an open line</p>
        <h1 class="fb__title">what’s on your mind?</h1>
        <p class="fb__lede">
          marka.md is built in the open. every idea, complaint, or "would be cool if…"
          helps shape the next release. pick the door that feels right.
        </p>
      </header>

      <section class="fb__cards" aria-label="Feedback options">
        <a class="fb__card" href={feedbackUrl} target="_blank" rel="noopener">
          <span class="fb__card-number" aria-hidden="true">01</span>
          <div class="fb__card-icon" aria-hidden="true">idea</div>
          <h2 class="fb__card-title">share an idea or feature request</h2>
          <p class="fb__card-body">
            opens a structured form on github. best for ideas, missing features,
            or things you wish worked differently. requires a github account.
          </p>
          <span class="fb__card-cta">open feedback form →</span>
        </a>

        <a class="fb__card" href={bugUrl} target="_blank" rel="noopener">
          <span class="fb__card-number" aria-hidden="true">02</span>
          <div class="fb__card-icon" aria-hidden="true">bug</div>
          <h2 class="fb__card-title">report a bug</h2>
          <p class="fb__card-body">
            something not working? this opens a quick bug report form with the
            fields i need to reproduce it. version + platform + steps.
          </p>
          <span class="fb__card-cta">open bug report →</span>
        </a>

        <a class="fb__card" href={mailto}>
          <span class="fb__card-number" aria-hidden="true">03</span>
          <div class="fb__card-icon" aria-hidden="true">hello</div>
          <h2 class="fb__card-title">just send an email</h2>
          <p class="fb__card-body">
            no github account, no form, no public thread. opens your mail app
            with a draft to me directly. honest thoughts welcome.
          </p>
          <span class="fb__card-cta">send email →</span>
        </a>
      </section>

      <p class="fb__note" role="note">
        i read everything. response time depends on the channel — github usually
        within a day or two, email when i can. salamat 🐙
      </p>
    </article>
  </main>

  <SiteFooter version={version} />
</Layout>

<style is:global>
  .fb { min-height: calc(100svh - 56px); padding: 56px 24px 32px; background: linear-gradient(135deg, var(--bg) 0%, var(--accent-soft) 155%); }
  .fb__article {
    max-width: 1280px;
    margin: 0 auto;
    color: var(--fg);
    min-height: calc(100svh - 144px);
    display: grid;
    grid-template-columns: minmax(260px, .7fr) minmax(0, 1.3fr);
    grid-template-rows: 1fr auto;
    gap: 32px 64px;
    align-items: center;
  }
  .fb__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .fb__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.2vw, 92px);
    line-height: .95;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin-bottom: 24px;
  }
  .fb__accent { color: var(--accent); }
  .fb__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 420px;
  }
  .fb__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    background: var(--border);
  }
  .fb__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    min-height: 390px;
    padding: 28px;
    background: color-mix(in srgb, #fff 88%, transparent);
    text-decoration: none;
    color: inherit;
    transition: transform 260ms ease, background 260ms ease, color 260ms ease;
  }
  .fb__card:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-8px);
  }
  .fb__card:hover .fb__card-title, .fb__card:hover .fb__card-body, .fb__card:hover .fb__card-cta { color: inherit; }
  .fb__card-number { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .fb__card:hover .fb__card-number { color: color-mix(in srgb, #fff 70%, transparent); }
  .fb__card-icon {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--accent);
  }
  .fb__card-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--fg);
    margin: 0;
  }
  .fb__card-body {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
    flex-grow: 1;
  }
  .fb__card-cta {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-top: 4px;
  }
  .fb__note {
    grid-column: 1 / -1;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    padding-top: 20px;
    border-top: 1px solid var(--border);
    max-width: none;
  }
  @media (max-width: 800px) {
    .fb { padding-top: 40px; }
    .fb__article { display: block; min-height: 0; }
    .fb__intro { margin-bottom: 40px; }
    .fb__cards { grid-template-columns: 1fr; }
    .fb__card { min-height: 0; }
    .fb__note { margin-top: 36px; }
  }
</style>
