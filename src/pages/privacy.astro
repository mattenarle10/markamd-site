---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getLatestRelease } from "../lib/version";
const repoUrl = "https://github.com/mattenarle10/markamd";
const { tag: version } = await getLatestRelease();
const lastUpdated = "2026-05-14";
---

<Layout
  title="privacy · marka.md"
  description="marka.md is local-first. it collects nothing, sends nothing, stores nothing outside your machine."
>
  <SiteNav />

  <main class="privacy">
    <article class="privacy__article">
      <header class="privacy__hero">
        <div>
          <p class="privacy__eyebrow">a plain promise</p>
          <h1 class="privacy__title">your notes<br />stay <span class="privacy__accent">yours.</span></h1>
        </div>
        <p class="privacy__lede">
          the app does not transmit, log, or store any personal data outside your machine.
          no telemetry. no analytics. no crash reporting. no account, no cloud, no sign-in.
          (this website itself does use cookieless aggregate analytics — see
          <a href="#about-this-website">about this website</a> below.)
        </p>
      </header>

      <div class="privacy__contract">
      <section class="privacy__section privacy__section--wide">
        <h2 class="privacy__h2">what stays on your computer</h2>
        <ul class="privacy__list">
          <li>
            the markdown files you open or edit — they remain in the folders you chose.
            we never move, copy, or upload them.
          </li>
          <li>
            your ui preferences (theme, sidebar width, recent file list, splitter ratio,
            welcome-tutorial flag) — stored in the app's local
            <code>localStorage</code>, keyed under <code>mdview.*</code>. clearing the
            app data resets these to defaults.
          </li>
        </ul>
      </section>

      <section class="privacy__section">
        <h2 class="privacy__h2">what we don't do</h2>
        <ul class="privacy__list">
          <li>no network requests are made by the app — no CDN, no fonts loaded remotely, no telemetry beacons.</li>
          <li>no third-party scripts, no tracking pixels, no fingerprinting.</li>
          <li>no account creation, no sync service, no remote storage.</li>
          <li>no crash reports or usage stats are sent anywhere.</li>
        </ul>
      </section>

      <section class="privacy__section">
        <h2 class="privacy__h2">third-party assets (bundled, not fetched)</h2>
        <ul class="privacy__list">
          <li>
            <strong>shiki</strong> (code syntax highlighting),
            <strong>katex</strong> (math),
            <strong>mermaid</strong> (diagrams) — these libraries are bundled inside
            the app and run entirely on your device. they do not call home.
          </li>
          <li>
            <strong>system fonts only</strong> — sf pro, jetbrains mono. no webfont fetches.
          </li>
        </ul>
      </section>

      <section class="privacy__section privacy__section--statement">
        <h2 class="privacy__h2">your data is yours</h2>
        <p class="privacy__p">
          marka.md works because your notes are just files on disk. delete the app, your
          notes stay. move them, rename them, sync them with whatever you like — marka.md
          has no opinion. there is no proprietary format, no database, no lock-in.
        </p>
      </section>

      <section class="privacy__section privacy__section--wide" id="about-this-website">
        <h2 class="privacy__h2">about this website</h2>
        <p class="privacy__p">
          this notice is about the <strong>marka.md app</strong>. the landing site you're
          reading right now (<code>markamd.vercel.app</code>) uses
          <strong>vercel web analytics</strong> and <strong>speed insights</strong>:
        </p>
        <ul class="privacy__list">
          <li>cookieless — no tracking cookies set, no fingerprinting.</li>
          <li>aggregated only — anonymized page-view counts and core-web-vitals timing. no individual identifiers, no cross-site tracking.</li>
          <li>first-party — data stays in vercel's analytics dashboard. nothing is shared with third parties or ad networks.</li>
          <li>see vercel's own privacy commitment at <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener">vercel.com/legal/privacy-policy</a>.</li>
        </ul>
        <p class="privacy__p">
          the app itself — the markdown editor you install on your device — does <strong>not</strong>
          load this analytics. only the website does. the app stays fully local-only as
          described above.
        </p>
      </section>

      <section class="privacy__section">
        <h2 class="privacy__h2">distribution</h2>
        <p class="privacy__p">
          all installers (macOS dmg, Windows setup, Linux AppImage / .deb / .rpm) are published on
          <a href={`${repoUrl}/releases`} target="_blank" rel="noopener">github releases</a>.
          downloads happen directly from github's CDN; they do not pass through any
          server we control. github's own privacy policy applies to the download itself.
        </p>
      </section>

      <section class="privacy__section">
        <h2 class="privacy__h2">changes</h2>
        <p class="privacy__p">
          last updated: <strong>{lastUpdated}</strong>. if this policy changes, the
          updated version will appear here. the source of this page is part of the
          open-source repository — diffs are public.
        </p>
      </section>

      <section class="privacy__section">
        <h2 class="privacy__h2">contact</h2>
        <p class="privacy__p">
          questions or concerns: open an issue at
          <a href={`${repoUrl}/issues`} target="_blank" rel="noopener">github.com/mattenarle10/markamd/issues</a>.
        </p>
      </section>

      </div>
      <p class="privacy__version">marka.md · {version} · MIT</p>
    </article>
  </main>

  <SiteFooter version={version} />
</Layout>

<style is:global>
  .privacy { padding: 88px 24px 96px; background: var(--bg); }
  .privacy__article {
    max-width: 1180px;
    margin: 0 auto;
    color: var(--fg);
  }
  .privacy__hero { min-height: min(680px, calc(100svh - 140px)); display: grid; grid-template-columns: 1.2fr .8fr; gap: 64px; align-items: end; padding: 32px 0 72px; border-bottom: 1px solid var(--border); }
  .privacy__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .privacy__title {
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 120px);
    line-height: .9;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0;
  }
  .privacy__accent { color: var(--accent); }
  .privacy__lede {
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    align-self: end;
  }
  .privacy__contract { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 64px; padding-top: 64px; }
  .privacy__section { padding: 0 0 44px; margin: 0 0 40px; border-bottom: 1px solid var(--border); }
  .privacy__section--wide { grid-column: 1 / -1; max-width: 760px; }
  .privacy__section--statement { padding: 42px; background: var(--accent-soft); border: 0; border-radius: 16px; }
  .privacy__h2 {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.015em;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 16px;
  }
  .privacy__list {
    margin: 0;
    padding-left: 22px;
    list-style: square;
    color: var(--muted);
  }
  .privacy__list li {
    font-size: 16px;
    line-height: 1.65;
    margin-bottom: 10px;
  }
  .privacy__list li::marker { color: var(--accent); }
  .privacy__list code,
  .privacy__p code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 1px 6px;
    border-radius: 4px;
  }
  .privacy__list strong,
  .privacy__p strong {
    color: var(--fg);
    font-weight: 600;
  }
  .privacy__p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }
  .privacy__p a,
  .privacy__list a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    transition: border-color 180ms ease;
  }
  .privacy__p a:hover,
  .privacy__list a:hover {
    border-bottom-color: var(--accent);
  }
  .privacy__version {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-align: left;
  }
  @media (max-width: 720px) {
    .privacy { padding-top: 48px; }
    .privacy__hero, .privacy__contract { display: block; }
    .privacy__hero { min-height: 0; padding: 32px 0 52px; }
    .privacy__lede { margin-top: 36px; }
    .privacy__section { margin-bottom: 32px; }
  }

</style>
