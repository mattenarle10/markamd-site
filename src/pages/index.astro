---
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";
import Typewriter from "../components/Typewriter.astro";
import {
  FeaturedSection,
  FaqSection,
  FeaturesSection,
  FinalCta,
  HeroSection,
  HomeNav,
  LoopSection,
  ReleaseSection,
  ScreenSection,
  ShortcutStrip,
  ThemeSection,
} from "../components/home";
import SiteFooter from "../components/SiteFooter.astro";
import {
  featured,
  features,
  getReleaseHighlight,
  repoUrl,
  shortcuts,
  steps,
  themeFamilies,
} from "../lib/home-content";
import { getLatestRelease, getRepoStats } from "../lib/version";

const { tag: version, macUrl, macIntelUrl, windowsUrl, linuxUrl, releasesPageUrl } = await getLatestRelease();
const stats = await getRepoStats();
const macHref = macUrl || releasesPageUrl;
const macIntelHref = macIntelUrl || releasesPageUrl;
const windowsHref = windowsUrl || releasesPageUrl;
const linuxHref = linuxUrl || releasesPageUrl;
const hasMacIntel = macIntelUrl.length > 0;
const hasWindows = windowsUrl.length > 0;
const hasLinux = linuxUrl.length > 0;
const releaseHighlight = getReleaseHighlight(version);
---

<Layout>
  <HomeNav repoUrl={repoUrl} macHref={macHref} version={version} />
  <HeroSection
    version={version}
    repoUrl={repoUrl}
    macHref={macHref}
    macIntelHref={macIntelHref}
    windowsHref={windowsHref}
    linuxHref={linuxHref}
    releasesPageUrl={releasesPageUrl}
    hasMacIntel={hasMacIntel}
    hasWindows={hasWindows}
    hasLinux={hasLinux}
  />
  <ScreenSection />
  <ReleaseSection releaseHighlight={releaseHighlight} />
  <ShortcutStrip shortcuts={shortcuts} />
  <ThemeSection themeFamilies={themeFamilies} />
  <LoopSection steps={steps} />
  <Typewriter
    lines={[
      { text: "context-ready markdown.", tone: "fg" },
      { text: "stage files. copy one clean bundle.", tone: "muted" },
    ]}
  />
  <FeaturesSection features={features} />
  <FeaturedSection featured={featured} stats={stats} />
  <FaqSection repoUrl={repoUrl} />
  <FinalCta version={version} macHref={macHref} repoUrl={repoUrl} />
  <SiteFooter version={version} />
</Layout>

<script>
  import "../scripts/home";
</script>
