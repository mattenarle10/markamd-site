---
import Layout from "../layouts/Layout.astro";
import HeroMascot from "../components/HeroMascot.astro";
import Reveal from "../components/Reveal.astro";
import FeatureCard from "../components/FeatureCard.astro";
import AppPreview from "../components/AppPreview.astro";
import Typewriter from "../components/Typewriter.astro";
import AppleIcon from "../components/icons/AppleIcon.astro";
import WindowsIcon from "../components/icons/WindowsIcon.astro";
import LinuxIcon from "../components/icons/LinuxIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import CopyIcon from "../components/icons/CopyIcon.astro";
import CheckIcon from "../components/icons/CheckIcon.astro";
import { getLatestRelease } from "../lib/version";

const repoUrl = "https://github.com/mattenarle10/markamd";
const { tag: version, macUrl, windowsUrl, linuxUrl, releasesPageUrl } = await getLatestRelease();
// fall back gracefully when an asset isn't published yet (e.g. linuxUrl pre-v1.1.1)
const macHref = macUrl || releasesPageUrl;
const windowsHref = windowsUrl || releasesPageUrl;
const linuxHref = linuxUrl || releasesPageUrl;
const hasWindows = windowsUrl.length > 0;
const hasLinux = linuxUrl.length > 0;

const features = [
  {
    title: "IDE-style sidebar",
    body: "drag files between folders. right-click for rename, new file, new folder. ⌘⌥Z to undo. your context library, organized like a project.",
  },
  {
    title: "live preview",
    body: "edit on the left, watch markdown render on the right. mermaid + shiki, all live.",
  },
  {
    title: "reading mode",
    body: "press ⌘. for a calm, preview-only view with generous typography. perfect for proofing before you paste.",
  },
  {
    title: "share with ai",
    body: "press ⌘⇧C to copy the current file as clean markdown. paste into claude, chatgpt, gemini, your local agent — anywhere that reads text.",
  },
  {
    title: "find · undo · all keyboard",
    body: "⌘F find/replace, ⌘⌥Z undo file ops, ⌘K command palette grouped by category. it's all there. 5 themes too — catppuccin + matcha.",
  },
  {
    title: "stays local",
    body: "your notes never leave your machine. no telemetry, no cloud, no account. just files.",
  },
];

const steps = [
  {
    n: "01",
    art: "/mascot/notebook.png",
    title: "collect",
    body: "open a folder of markdown notes. that's your context library.",
  },
  {
    n: "02",
    art: "/mascot/pen.png",
    title: "write",
    body: "edit side-by-side with live preview. save when ready.",
  },
  {
    n: "03",
    art: "/mascot/excite.png",
    title: "share",
    body: "copy clean markdown to clipboard. paste into claude.",
  },
];

const shortcuts: { key: string; label: string }[] = [
  { key: "⌘K", label: "command palette" },
  { key: "⌘⇧O", label: "open folder" },
  { key: "⌘S", label: "save" },
  { key: "⌘.", label: "reading mode" },
  { key: "⌘⇧C", label: "copy markdown" },
  { key: "⌘B", label: "toggle sidebar" },
  { key: "⌘/", label: "help" },
];
---

<Layout>
  <header class="nav">
    <div class="nav__inner">
      <a href="/" class="nav__brand">
        <img src="/mascot/logo.png" alt="" width="28" height="28" />
        <span>marka.md</span>
      </a>
      <nav class="nav__links">
        <a href="#features" class="nav__link">features</a>
        <a href={repoUrl} target="_blank" rel="noopener" class="nav__link">github</a>
        <a href={macHref} target="_blank" rel="noopener" class="nav__cta">
          download {version}
          <span aria-hidden>↓</span>
        </a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero__glow" aria-hidden></div>
    <div class="hero__orbs" aria-hidden>
      <span class="hero__orb hero__orb--a"></span>
      <span class="hero__orb hero__orb--b"></span>
      <span class="hero__orb hero__orb--c"></span>
    </div>
    <div class="hero__inner">
      <Reveal class="hero__mascot">
        <HeroMascot size={148} />
      </Reveal>
      <Reveal as="h1" delay={120} class="hero__title">
        <span class="reveal-child">write markdown.</span>
        <span class="reveal-child">share with ai.</span>
        <span class="reveal-child accent">
          nothing leaves your machine.<span class="caret hero__caret" aria-hidden="true"></span>
        </span>
      </Reveal>
      <Reveal as="p" delay={420} class="hero__sub">
        the calm markdown editor for the notes you share with ai. local-first, MIT, macOS + Windows.
      </Reveal>
      <Reveal delay={540} class="hero__ctas">
        <div
          class="dl"
          data-dl
          data-mac={macHref}
          data-windows={hasWindows ? windowsHref : ""}
          data-linux={hasLinux ? linuxHref : ""}
        >
          <a
            href={macHref}
            target="_blank"
            rel="noopener"
            class="dl__primary"
            data-dl-primary
            aria-label="download for macOS"
          >
            <span class="dl__primary-icon" data-dl-icon aria-hidden="true">
              <AppleIcon size={15} />
            </span>
            <span class="dl__primary-text">
              <span data-dl-label>download for macOS</span>
              <span class="dl__primary-ver">{version}</span>
            </span>
          </a>
          <button
            type="button"
            class="dl__chevron"
            data-dl-toggle
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="dl-menu"
            aria-label="show all platforms"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="dl__menu" id="dl-menu" role="menu" data-dl-menu>
            <p class="dl__menu-eyebrow" aria-hidden="true">choose your platform</p>
            <a class="dl__row" href={macHref} target="_blank" rel="noopener" role="menuitem" data-dl-row="mac">
              <span class="dl__row-icon"><AppleIcon size={16} /></span>
              <span class="dl__row-text">
                <span class="dl__row-title">macOS</span>
                <span class="dl__row-meta">apple silicon · notarized · auto-updates</span>
              </span>
              <span class="dl__row-arrow" aria-hidden="true">↓</span>
            </a>
            <a
              class={`dl__row${hasWindows ? "" : " dl__row--soon"}`}
              href={hasWindows ? windowsHref : releasesPageUrl}
              target="_blank"
              rel="noopener"
              role="menuitem"
              data-dl-row="windows"
              aria-disabled={hasWindows ? "false" : "true"}
            >
              <span class="dl__row-icon"><WindowsIcon size={16} /></span>
              <span class="dl__row-text">
                <span class="dl__row-title">Windows</span>
                <span class="dl__row-meta">{hasWindows ? "10+ · x64 · auto-updates" : "coming soon"}</span>
              </span>
              <span class="dl__row-arrow" aria-hidden="true">{hasWindows ? "↓" : ""}</span>
              {!hasWindows && <span class="dl__row-badge">soon</span>}
            </a>
            <a
              class={`dl__row${hasLinux ? "" : " dl__row--soon"}`}
              href={hasLinux ? linuxHref : releasesPageUrl}
              target="_blank"
              rel="noopener"
              role="menuitem"
              data-dl-row="linux"
              aria-disabled={hasLinux ? "false" : "true"}
            >
              <span class="dl__row-icon"><LinuxIcon size={16} /></span>
              <span class="dl__row-text">
                <span class="dl__row-title">Linux</span>
                <span class="dl__row-meta">{hasLinux ? "x86_64 · AppImage" : "coming in v1.1.1"}</span>
              </span>
              <span class="dl__row-arrow" aria-hidden="true">{hasLinux ? "↓" : ""}</span>
              {!hasLinux && <span class="dl__row-badge">soon</span>}
            </a>
          </div>
        </div>
        <a href={repoUrl} target="_blank" rel="noopener" class="btn btn--ghost">
          <GithubIcon size={14} />
          view source
        </a>
      </Reveal>
      <Reveal as="p" delay={600} class="hero__status">
        <span class="hero__status-pill">
          <span class="hero__status-dot" aria-hidden></span>
          notarized on macOS · auto-updating · macOS + Windows
        </span>
        <a href="/changelog" class="hero__status-link">view changelog →</a>
      </Reveal>
      <Reveal as="p" delay={660} class="hero__trust">
        local-first · MIT · macOS 13+ · Windows 10+ · no telemetry
      </Reveal>
    </div>
  </section>

  <section class="screen-wrap">
    <Reveal class="screen-frame">
      <AppPreview />
    </Reveal>
  </section>

  <section class="keys">
    <Reveal class="keys__inner">
      <p class="eyebrow keys__caption">made for the keyboard.</p>
      <div class="keys__grid">
        {shortcuts.map((s) => (
          <kbd
            class="key reveal-child"
            data-tooltip={s.label}
            aria-label={`${s.label} — keyboard shortcut ${s.key}`}
          >
            {s.key}
          </kbd>
        ))}
      </div>
    </Reveal>
  </section>

  <section id="how" class="loop">
    <div class="loop__inner">
      <Reveal class="section-head">
        <p class="eyebrow">how it works</p>
        <h2 class="h2">one loop. nothing leaves your machine.</h2>
      </Reveal>
      <Reveal class="loop__grid">
        {
          steps.map((s) => (
            <div class="slide reveal-child">
              <div class="slide__halo" aria-hidden></div>
              <img src={s.art} alt="" width="112" height="112" class="slide__art" />
              <p class="slide__n">{s.n}</p>
              <h3 class="slide__title">{s.title}</h3>
              <p class="slide__body">{s.body}</p>
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  <Typewriter
    lines={[
      { text: "context-ready markdown.", tone: "fg" },
      { text: "built for the prompts you actually paste.", tone: "muted" },
    ]}
  />

  <section id="features" class="features">
    <div class="features__inner">
      <Reveal class="section-head">
        <p class="eyebrow">features</p>
        <h2 class="h2 h2--split" data-words>
          <span class="word">everything</span>{" "}
          <span class="word">you</span>{" "}
          <span class="word">need</span>{" "}
          <span class="word">to</span>{" "}
          <span class="word">read,</span>{" "}
          <span class="word">write,</span>{" "}
          <span class="word">share.</span>
        </h2>
      </Reveal>
      <Reveal class="features__grid">
        {features.map((f) => <FeatureCard title={f.title} body={f.body} />)}
      </Reveal>
    </div>
  </section>

  <section class="final">
    <Reveal class="final__inner">
      <img src="/mascot/inspect.png" alt="" width="120" height="120" class="final__art" />
      <h2 class="final__title">
        ready to ship cleaner <span class="accent">context</span>?
      </h2>
      <div class="final__ctas">
        <a href={macHref} target="_blank" rel="noopener" class="btn btn--accent">
          <AppleIcon size={14} />
          download {version}
        </a>
        <a href={repoUrl} target="_blank" rel="noopener" class="btn btn--ghost-dark">
          <GithubIcon size={14} />
          view on github
        </a>
      </div>
    </Reveal>
  </section>

  <footer class="foot">
    <div class="foot__featured">
      <a
        href="https://www.producthunt.com/products/marka-md?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-marka-md"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="marka.md featured on Product Hunt"
      >
        <img
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1148089&theme=light&t=1778916303617"
          alt="marka.md - the markdown editor for AI context. | Product Hunt"
          width="250"
          height="54"
          loading="lazy"
        />
      </a>
    </div>
    <div class="foot__inner">
      <div class="foot__brand">
        <img src="/mascot/logo.png" alt="" width="20" height="20" />
        <span>marka.md · {version}</span>
      </div>
      <nav class="foot__links">
        <a href={repoUrl} target="_blank" rel="noopener">github</a>
        <a href="/changelog">changelog</a>
        <a href="/privacy">privacy</a>
        <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
        <a href={`${repoUrl}/issues`} target="_blank" rel="noopener">report a bug</a>
      </nav>
    </div>
  </footer>
</Layout>

<style is:global>
  /* ─── nav ─────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }
  .nav.is-scrolled { border-bottom-color: var(--border); }
  .nav__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .nav__brand img { transition: transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .nav__brand:hover img { transform: rotate(8deg); }
  .nav__links { display: flex; align-items: center; gap: 4px; }
  .nav__link {
    padding: 6px 12px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .nav__link:hover { color: var(--fg); }
  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 4px;
    padding: 8px 16px;
    background: var(--fg);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    border-radius: 999px;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav__cta:hover { background: var(--accent); transform: translateY(-1px); }
  @media (max-width: 640px) {
    .nav__link { display: none; }
    .nav__inner { padding: 0 16px; }
    .nav__cta { padding: 7px 12px; font-size: 12px; }
    .nav__cta .btn__ver { display: none; }
  }
  @media (max-width: 380px) {
    .nav__brand span { display: none; }
  }

  /* ─── shared ──────────────────────────────────────────── */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--fg);
  }
  /* split-word reveal — each .word is animated by word-reveal.ts */
  .h2--split .word {
    display: inline-block;
    will-change: transform, opacity;
  }
  .section-head { text-align: center; margin-bottom: 64px; }
  .accent { color: var(--accent); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
    border: 1px solid transparent;
  }
  .btn--primary { background: var(--fg); color: #fff; }
  .btn--primary:hover { background: var(--accent); transform: translateY(-2px) scale(1.01); }
  .btn__ver { opacity: 0.55; font-family: var(--font-mono); font-size: 12px; }
  .btn--ghost { background: #fff; color: var(--fg); border-color: var(--border); }
  .btn--ghost:hover { border-color: var(--fg); }
  .btn--accent {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 40%, transparent);
    animation: cta-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 35%, transparent); }
    50%      { box-shadow: 0 0 0 14px color-mix(in srgb, var(--accent) 0%, transparent); }
  }
  .btn--accent:hover { background: #fff; color: var(--fg); animation: none; }
  .btn--ghost-dark {
    color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 0.18);
    background: transparent;
  }
  .btn--ghost-dark:hover { color: #fff; border-color: rgba(255, 255, 255, 0.45); }

  /* ─── hero ─────────────────────────────────────────────── */
  .hero { position: relative; overflow: hidden; }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, var(--accent-soft) 0%, transparent 55%);
    z-index: -2;
    pointer-events: none;
  }
  /* ambient orbs — minimal warm haze, drifted by GSAP in hero-ambient.ts */
  .hero__orbs {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 65%);
    mix-blend-mode: multiply;
    filter: blur(8px);
    will-change: transform;
  }
  .hero__orb--a {
    top: 8%;
    left: 12%;
    width: 320px;
    height: 320px;
    opacity: 0.55;
  }
  .hero__orb--b {
    top: 35%;
    right: 6%;
    width: 460px;
    height: 460px;
    opacity: 0.7;
  }
  .hero__orb--c {
    bottom: 8%;
    left: 38%;
    width: 220px;
    height: 220px;
    opacity: 0.5;
  }
  @media (max-width: 640px) {
    .hero__orb--a { width: 200px; height: 200px; }
    .hero__orb--b { width: 260px; height: 260px; }
    .hero__orb--c { width: 160px; height: 160px; }
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 96px 24px 112px;
    text-align: center;
  }
  @media (min-width: 640px) { .hero__inner { padding: 144px 24px 144px; } }
  .hero__mascot { margin-bottom: 36px; }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    margin-bottom: 28px;
  }
  .hero__sub {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto 36px;
    line-height: 1.55;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
    /* hoist above sibling Reveal blocks (status pill, trust line) so the
       dropdown menu doesn't get painted under them. Reveal wrappers create
       their own stacking contexts via transforms — without this, the menu's
       internal z-index can't escape to overlay later siblings. */
    position: relative;
    z-index: 20;
  }
  .hero__status, .hero__trust { position: relative; z-index: 1; }
  @media (max-width: 480px) {
    .hero__ctas { flex-direction: column; align-items: stretch; padding: 0 8px; }
    .hero__ctas .btn { justify-content: center; }
  }
  @media (max-width: 640px) {
    .hero__inner { padding: 72px 20px 88px; }
  }
  .hero__status {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }
  .hero__status-link {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 180ms ease;
  }
  .hero__status-link:hover { color: var(--accent); }
  .hero__status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 9px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: color-mix(in srgb, var(--accent) 85%, var(--fg));
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .hero__status-pill { white-space: normal; text-align: center; max-width: 100%; }
  }
  .hero__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: hero-status-pulse 2.2s ease-in-out infinite;
  }
  @keyframes hero-status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__status-dot { animation: none; }
  }
  .hero__trust {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  /* hero caret — visuals come from .caret in global.css; this only
     overrides the gap from the trailing period. */
  .hero__caret { margin-left: 0.1em; }

  /* ─── screen ──────────────────────────────────────────── */
  .screen-wrap { max-width: var(--max-content); margin: 0 auto; padding: 0 24px 96px; }
  @media (min-width: 640px) { .screen-wrap { padding: 0 24px 128px; } }
  .screen-frame { margin: 0 auto; }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    transform: rotateX(2deg);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reveal.is-visible .screen { transform: rotateX(0deg); }
  .screen__art { opacity: 0.9; margin-bottom: 20px; }
  .screen__hint { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
