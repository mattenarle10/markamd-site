---
import Layout from "../layouts/Layout.astro";
import HeroMascot from "../components/HeroMascot.astro";
import Reveal from "../components/Reveal.astro";
import FeatureCard from "../components/FeatureCard.astro";
import AppPreview from "../components/AppPreview.astro";
import Typewriter from "../components/Typewriter.astro";
import { getLatestVersion } from "../lib/version";

const releaseUrl = "https://github.com/mattenarle10/markamd/releases/latest";
const repoUrl = "https://github.com/mattenarle10/markamd";
const version = await getLatestVersion();

const features = [
  {
    title: "live preview",
    body: "edit on the left, watch markdown render on the right. mermaid + math + shiki, all live.",
  },
  {
    title: "reading mode",
    body: "press ⌘. for a calm, preview-only view with generous typography. perfect for proofing.",
  },
  {
    title: "folder search",
    body: "open a folder of notes. tap the search icon to fuzzy-find every .md in the tree.",
  },
  {
    title: "copy for claude",
    body: "press ⌘⇧C to copy the current file as clean markdown. paste straight into any chat.",
  },
  {
    title: "5 themes",
    body: "catppuccin latte, frappé, macchiato, mocha — plus a custom matcha. transparency toggle.",
  },
  {
    title: "stays local",
    body: "your notes never leave your machine. no telemetry, no cloud, no account. just files.",
  },
];

const steps = [
  {
    n: "01",
    art: "/mascot/notebook.png",
    title: "collect",
    body: "open a folder of markdown notes. that's your context library.",
  },
  {
    n: "02",
    art: "/mascot/pen.png",
    title: "write",
    body: "edit side-by-side with live preview. save when ready.",
  },
  {
    n: "03",
    art: "/mascot/excite.png",
    title: "share",
    body: "copy clean markdown to clipboard. paste into claude.",
  },
];

const shortcuts: { key: string; label: string }[] = [
  { key: "⌘K", label: "command palette" },
  { key: "⌘⇧O", label: "open folder" },
  { key: "⌘S", label: "save" },
  { key: "⌘.", label: "reading mode" },
  { key: "⌘⇧C", label: "copy markdown" },
  { key: "⌘B", label: "toggle sidebar" },
  { key: "⌘/", label: "help" },
];
---

<Layout>
  <header class="nav">
    <div class="nav__inner">
      <a href="/" class="nav__brand">
        <img src="/mascot/logo.png" alt="" width="28" height="28" />
        <span>marka.md</span>
      </a>
      <nav class="nav__links">
        <a href="#features" class="nav__link">features</a>
        <a href={repoUrl} target="_blank" rel="noopener" class="nav__link">github</a>
        <a href={releaseUrl} target="_blank" rel="noopener" class="nav__cta">
          download {version}
          <span aria-hidden>↓</span>
        </a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero__glow" aria-hidden></div>
    <div class="hero__inner">
      <Reveal class="hero__mascot">
        <HeroMascot size={148} />
      </Reveal>
      <Reveal as="h1" delay={120} class="hero__title">
        <span class="reveal-child">write markdown.</span>
        <span class="reveal-child">share with ai.</span>
        <span class="reveal-child accent">
          nothing leaves your machine.<span class="hero__caret" aria-hidden="true">▍</span>
        </span>
      </Reveal>
      <Reveal as="p" delay={420} class="hero__sub">
        the calm markdown editor for the notes you ship to claude. local-first, MIT, macOS.
      </Reveal>
      <Reveal delay={540} class="hero__ctas">
        <a href={releaseUrl} target="_blank" rel="noopener" class="btn btn--primary">
          download for macOS
          <span class="btn__ver">{version}</span>
          <span aria-hidden>↓</span>
        </a>
        <a href={repoUrl} target="_blank" rel="noopener" class="btn btn--ghost">
          view source
          <span aria-hidden>↗</span>
        </a>
      </Reveal>
      <Reveal as="p" delay={660} class="hero__trust">
        local-first · MIT · macOS 13+ · tauri 2
      </Reveal>
    </div>
  </section>

  <section class="screen-wrap">
    <Reveal class="screen-frame">
      <AppPreview />
    </Reveal>
  </section>

  <section class="keys">
    <Reveal class="keys__inner">
      <p class="eyebrow keys__caption">made for the keyboard.</p>
      <div class="keys__grid">
        {shortcuts.map((s) => (
          <kbd
            class="key reveal-child"
            data-tooltip={s.label}
            aria-label={`${s.label} — keyboard shortcut ${s.key}`}
          >
            {s.key}
          </kbd>
        ))}
      </div>
    </Reveal>
  </section>

  <section id="how" class="loop">
    <div class="loop__inner">
      <Reveal class="section-head">
        <p class="eyebrow">how it works</p>
        <h2 class="h2">one loop. nothing leaves your machine.</h2>
      </Reveal>
      <Reveal class="loop__grid">
        {
          steps.map((s) => (
            <div class="slide reveal-child">
              <div class="slide__halo" aria-hidden></div>
              <img src={s.art} alt="" width="112" height="112" class="slide__art" />
              <p class="slide__n">{s.n}</p>
              <h3 class="slide__title">{s.title}</h3>
              <p class="slide__body">{s.body}</p>
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  <Typewriter
    lines={[
      { text: "context-ready markdown.", tone: "fg" },
      { text: "built for the prompts you actually paste.", tone: "muted" },
    ]}
  />

  <section id="features" class="features">
    <div class="features__inner">
      <Reveal class="section-head">
        <p class="eyebrow">features</p>
        <h2 class="h2">everything you need to read, write, share.</h2>
      </Reveal>
      <Reveal class="features__grid">
        {features.map((f) => <FeatureCard title={f.title} body={f.body} />)}
      </Reveal>
    </div>
  </section>

  <section class="install">
    <Reveal class="install__inner">
      <p class="eyebrow">install</p>
      <h2 class="h2">drag, drop, done.</h2>
      <p class="install__lede">
        download the dmg → drag <span class="mono">marka.md.app</span> into your applications folder. that's it.
      </p>
      <div class="install__note">
        <p class="install__note-title">if macOS says "marka.md is damaged"</p>
        <p class="install__note-body">
          that's the unsigned-build warning macOS shows for apps outside the app store.
          paste this once in terminal — it clears apple's quarantine flag:
        </p>
        <pre class="install__code"><code>xattr -rd com.apple.quarantine /Applications/marka.md.app</code></pre>
        <p class="install__note-foot">
          apple developer signing is in flight. v1.0 will be fully notarized and you won't see this again.
        </p>
      </div>
    </Reveal>
  </section>

  <section class="final">
    <Reveal class="final__inner">
      <img src="/mascot/inspect.png" alt="" width="120" height="120" class="final__art" />
      <h2 class="final__title">
        ready to ship cleaner <span class="accent">context</span>?
      </h2>
      <div class="final__ctas">
        <a href={releaseUrl} target="_blank" rel="noopener" class="btn btn--accent">
          download {version}
          <span aria-hidden>↓</span>
        </a>
        <a href={repoUrl} target="_blank" rel="noopener" class="btn btn--ghost-dark">
          view on github <span aria-hidden>→</span>
        </a>
      </div>
    </Reveal>
  </section>

  <footer class="foot">
    <div class="foot__inner">
      <div class="foot__brand">
        <img src="/mascot/logo.png" alt="" width="20" height="20" />
        <span>marka.md · {version}</span>
      </div>
      <nav class="foot__links">
        <a href={repoUrl} target="_blank" rel="noopener">github</a>
        <a href="/privacy">privacy</a>
        <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">MIT</a>
        <a href={`${repoUrl}/issues`} target="_blank" rel="noopener">report a bug</a>
      </nav>
    </div>
  </footer>
</Layout>

<style is:global>
  /* ─── nav ─────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }
  .nav.is-scrolled { border-bottom-color: var(--border); }
  .nav__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .nav__brand img { transition: transform 300ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .nav__brand:hover img { transform: rotate(8deg); }
  .nav__links { display: flex; align-items: center; gap: 4px; }
  .nav__link {
    padding: 6px 12px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .nav__link:hover { color: var(--fg); }
  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 4px;
    padding: 8px 16px;
    background: var(--fg);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    border-radius: 999px;
    text-decoration: none;
    transition: background 200ms ease, transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nav__cta:hover { background: var(--accent); transform: translateY(-1px); }
  @media (max-width: 640px) { .nav__link { display: none; } }

  /* ─── shared ──────────────────────────────────────────── */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--fg);
  }
  .section-head { text-align: center; margin-bottom: 64px; }
  .accent { color: var(--accent); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
    border: 1px solid transparent;
  }
  .btn--primary { background: var(--fg); color: #fff; }
  .btn--primary:hover { background: var(--accent); transform: translateY(-2px) scale(1.01); }
  .btn__ver { opacity: 0.55; font-family: var(--font-mono); font-size: 12px; }
  .btn--ghost { background: #fff; color: var(--fg); border-color: var(--border); }
  .btn--ghost:hover { border-color: var(--fg); }
  .btn--accent {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 40%, transparent);
    animation: cta-pulse 2.4s ease-in-out infinite;
  }
  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 35%, transparent); }
    50%      { box-shadow: 0 0 0 14px color-mix(in srgb, var(--accent) 0%, transparent); }
  }
  .btn--accent:hover { background: #fff; color: var(--fg); animation: none; }
  .btn--ghost-dark {
    color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 0.18);
    background: transparent;
  }
  .btn--ghost-dark:hover { color: #fff; border-color: rgba(255, 255, 255, 0.45); }

  /* ─── hero ─────────────────────────────────────────────── */
  .hero { position: relative; overflow: hidden; }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, var(--accent-soft) 0%, transparent 55%);
    z-index: -1;
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 96px 24px 112px;
    text-align: center;
  }
  @media (min-width: 640px) { .hero__inner { padding: 144px 24px 144px; } }
  .hero__mascot { margin-bottom: 36px; }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 60px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    margin-bottom: 28px;
  }
  .hero__sub {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto 36px;
    line-height: 1.55;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  .hero__trust {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .hero__caret {
    display: inline-block;
    margin-left: 0.04em;
    color: var(--accent);
    animation: hero-blink 1s steps(2, end) infinite;
    transform: translateY(-0.04em);
    font-weight: 400;
    font-family: var(--font-mono);
    font-size: 0.7em;
  }
  @keyframes hero-blink {
    0%, 50%      { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__caret { animation: none; }
  }

  /* ─── screen ──────────────────────────────────────────── */
  .screen-wrap { max-width: var(--max-content); margin: 0 auto; padding: 0 24px 96px; }
  @media (min-width: 640px) { .screen-wrap { padding: 0 24px 128px; } }
  .screen-frame { margin: 0 auto; }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    transform: rotateX(2deg);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .reveal.is-visible .screen { transform: rotateX(0deg); }
  .screen__art { opacity: 0.9; margin-bottom: 20px; }
  .screen__hint { font-family: var(--font-mono); font-size: 13px; color: var(--muted); }
  .screen__hint code { color: var(--fg); }

  /* ─── loop ────────────────────────────────────────────── */
  .loop {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 96px 0;
  }
  @media (min-width: 640px) { .loop { padding: 128px 0; } }
  .loop__inner { max-width: var(--max-content); margin: 0 auto; padding: 0 24px; }
  .loop__grid { display: grid; grid-template-columns: 1fr; gap: 40px; }
  @media (min-width: 640px) { .loop__grid { grid-template-columns: repeat(3, 1fr); } }
  /* welcome-overlay-style slide cards */
  .slide {
    position: relative;
    text-align: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 40px 28px 36px;
    /* stretch all cards to equal height so labels/titles align across the row */
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
                border-color 320ms ease;
  }
  .slide:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 22px 50px -22px rgba(226, 114, 46, 0.28);
  }
  .slide__halo {
    position: absolute;
    inset: -2px 30% auto 30%;
    height: 130px;
    background: radial-gradient(ellipse at top, var(--accent-soft) 0%, transparent 70%);
    border-radius: 999px;
    pointer-events: none;
    opacity: 0.7;
  }
  /* fixed-height art frame — keeps the 01/02/03 labels and titles
     aligned across all 3 cards regardless of each mascot's intrinsic
     padding/aspect inside its PNG. */
  .slide__art {
    position: relative;
    display: block;
    width: 112px;
    height: 112px;
    object-fit: contain;
    margin: 0 auto 22px;
    filter: drop-shadow(0 14px 28px rgba(226, 114, 46, 0.18));
  }
  .slide__n {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .slide__title {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--fg);
  }
  .slide__body {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 24ch;
    margin: 0 auto;
  }

  /* big-type section now lives in Typewriter.astro (scroll-scrubbed) */

  /* ─── features ────────────────────────────────────────── */
  .features { padding: 96px 0; }
  @media (min-width: 640px) { .features { padding: 128px 0; } }
  .features__inner { max-width: var(--max-content); margin: 0 auto; padding: 0 24px; }
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  @media (min-width: 640px) { .features__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .features__grid { grid-template-columns: repeat(3, 1fr); } }

  /* ─── keys ────────────────────────────────────────────── */
  .keys {
    padding: 96px 24px;
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .keys__inner { max-width: var(--max-narrow); margin: 0 auto; text-align: center; }
  .keys__caption {
    font-size: 14px;
    text-transform: none;
    letter-spacing: -0.005em;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 36px;
  }
  .keys__grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .key {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    padding: 12px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--fg);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
    transition: transform 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .key:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }

  /* hover tooltip — sits above each chip, no JS */
  .key::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--fg);
    color: #fff;
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: -0.005em;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.35);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .key:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ─── install ─────────────────────────────────────────── */
  .install { padding: 96px 24px; background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  @media (min-width: 640px) { .install { padding: 128px 24px; } }
  .install__inner { max-width: var(--max-narrow); margin: 0 auto; text-align: center; }
  .install .eyebrow { text-align: center; }
  .install__lede {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.55;
    margin: 16px auto 36px;
    max-width: 480px;
  }
  .install__lede .mono {
    font-family: var(--font-mono);
    color: var(--fg);
    background: #fff;
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 5px;
    font-size: 14px;
  }
  .install__note {
    text-align: left;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px 24px 20px;
    box-shadow: 0 6px 24px -10px rgba(0, 0, 0, 0.1);
  }
  .install__note-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .install__note-body {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 14px;
  }
  .install__code {
    margin: 0 0 14px;
    padding: 14px 16px;
    background: #1d1d1f;
    color: #f4f4f3;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    overflow-x: auto;
    user-select: all;
  }
  .install__code code {
    font-family: inherit;
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .install__note-foot {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
  }

  /* ─── final cta ───────────────────────────────────────── */
  .final {
    background: var(--fg);
    color: #fff;
    padding: 128px 24px;
    text-align: center;
  }
